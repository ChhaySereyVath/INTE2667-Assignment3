# Copy this file to .env, then give EVERY key its own value from:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start if any key is missing. Never commit .env.
SECRET_KEY=
JWT_SECRET_KEY=
DATA_ENC_KEY=
BLIND_INDEX_KEY=
BACKUP_KEY=
AUDIT_SIGNING_KEY=
ACTION_SIGNING_KEY=
BALLOT_KEY=
DATABASE_URL=sqlite:///evp.db
FLASK_DEBUG=0
WEBAUTHN_RP_ID=localhost
# R01: set to https://localhost:5000 after `flask make-cert`, so security keys work over HTTPS
WEBAUTHN_ORIGIN=http://localhost:5000

